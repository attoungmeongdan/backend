# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atmd
DB_USER=atmd
DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=                          # [GitHub Secret] JWT_SECRET
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000

# OAuth2 - Kakao
KAKAO_CLIENT_ID=                     # [GitHub Secret] KAKAO_CLIENT_ID
KAKAO_CLIENT_SECRET=                 # [GitHub Secret] KAKAO_CLIENT_SECRET
KAKAO_REDIRECT_URI=http://localhost:8080/login/oauth2/code/kakao

# OAuth2 - Google
GOOGLE_CLIENT_ID=                    # [GitHub Secret] GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=                # [GitHub Secret] GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# AWS
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DOMAIN=

# Kakao Local API
KAKAO_LOCAL_REST_API_KEY=

# OpenAI
OPENAI_API_KEY=

# [GitHub Secret] vars (CI/CD)
# DOCKERHUB_USERNAME=
# DOCKERHUB_TOKEN=
# AWS_DEPLOY_ROLE_ARN=
# EC2_INSTANCE_ID=
